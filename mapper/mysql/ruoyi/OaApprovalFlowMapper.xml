<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="mapper/mysql/ruoyi/OaApprovalFlowMapper.xml">

    <!-- 通用查询结果列 -->
    <sql id="selectOaApprovalFlowVo">
        select flow_id, flow_code, flow_name, flow_type, description, status, remark, create_by, create_time, update_by, update_time from oa_approval_flow
    </sql>

    <!-- 查询审批流程配置列表 -->
    <select id="selectOaApprovalFlowList" parameterType="OaApprovalFlow" resultType="OaApprovalFlow">
        <include refid="selectOaApprovalFlowVo"/>
        <where>
            <if test="flowCode != null  and flowCode != ''"> and flow_code = #{flowCode}</if>
            <if test="flowName != null  and flowName != ''"> and flow_name like concat('%', #{flowName}, '%')</if>
            <if test="flowType != null  and flowType != ''"> and flow_type = #{flowType}</if>
            <if test="description != null  and description != ''"> and description = #{description}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
        order by create_time desc
    </select>

    <!-- 查询审批流程配置详细 -->
    <select id="selectOaApprovalFlowByFlowId" parameterType="Number" resultType="OaApprovalFlow">
        <include refid="selectOaApprovalFlowVo"/>
        where flow_id = #{flowId}
    </select>

    <!-- 新增审批流程配置 -->
    <insert id="insertOaApprovalFlow" parameterType="OaApprovalFlow" useGeneratedKeys="true" keyProperty="flowId">
        insert into oa_approval_flow
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="flowCode != null and flowCode != ''">flow_code,</if>
            <if test="flowName != null and flowName != ''">flow_name,</if>
            <if test="flowType != null and flowType != ''">flow_type,</if>
            <if test="description != null">description,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="flowCode != null and flowCode != ''">#{flowCode},</if>
            <if test="flowName != null and flowName != ''">#{flowName},</if>
            <if test="flowType != null and flowType != ''">#{flowType},</if>
            <if test="description != null">#{description},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <!-- 修改审批流程配置 -->
    <update id="updateOaApprovalFlow" parameterType="OaApprovalFlow">
        update oa_approval_flow
        <trim prefix="SET" suffixOverrides=",">
            <if test="flowCode != null and flowCode != ''">flow_code = #{flowCode},</if>
            <if test="flowName != null and flowName != ''">flow_name = #{flowName},</if>
            <if test="flowType != null and flowType != ''">flow_type = #{flowType},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where flow_id = #{flowId}
    </update>

    <!-- 删除审批流程配置 -->
    <delete id="deleteOaApprovalFlowByFlowId" parameterType="Number">
        delete from oa_approval_flow where flow_id = #{flowId}
    </delete>

    <!-- 批量删除审批流程配置 -->
    <delete id="deleteOaApprovalFlowByFlowIds" parameterType="String">
        delete from oa_approval_flow where flow_id in
        <foreach item="flowId" collection="array" open="(" separator="," close=")">
            #{flowId}
        </foreach>
    </delete>
</mapper>
